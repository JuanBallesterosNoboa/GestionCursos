@model CursoModel
@{ ViewData["Title"] = "Editar curso"; }
<section class="panel formulario">
    <h1>Editar curso</h1>
    <form asp-action="Edit" asp-route-id="@Model.curso_id" method="post">
        <input type="hidden" asp-for="curso_id" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <partial name="_Campos" model="Model" />
        <div class="acciones margen"><button class="btn primario" type="submit">Guardar cambios</button>
            <a class="btn claro" asp-action="Index">Cancelar</a></div>
    </form>
</section>
