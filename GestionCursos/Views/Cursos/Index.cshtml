@model IEnumerable<CursoModel>
@{
    ViewData["Title"] = "Cursos";
}
<div class="titulo-fila">
    <div><h1>Listado de cursos</h1><p>Crear, consultar, editar y eliminar cursos.</p></div>
    <a class="btn exito" asp-action="Create">+ Nuevo curso</a>
</div>
<section class="panel tabla-wrap">
    <table>
        <thead><tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Inicio</th><th>Fin</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.curso_id</td>
                <td><strong>@x.nombre</strong></td>
                <td>@x.descripcion</td>
                <td>@x.fecha_inicio.ToString("dd/MM/yyyy")</td>
                <td>@x.fecha_fin.ToString("dd/MM/yyyy")</td>
                <td><div class="acciones">
                    <a class="btn pequeno claro" asp-action="Details" asp-route-id="@x.curso_id">Ver</a>
                    <a class="btn pequeno primario" asp-action="Edit" asp-route-id="@x.curso_id">Editar</a>
                    <a class="btn pequeno peligro" asp-action="Delete" asp-route-id="@x.curso_id">Eliminar</a>
                </div></td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="vacio">No existen cursos registrados.</p> }
</section>
