@model InscripcionModel
@{ ViewData["Title"] = "Editar inscripción"; }
<section class="panel formulario">
    <h1>Editar inscripción</h1>
    <form asp-action="Edit" asp-route-id="@Model.inscripcion_id" method="post">
        <input type="hidden" asp-for="inscripcion_id" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <partial name="_Campos" model="Model" />
        <div class="acciones margen"><button type="submit" class="btn primario">Guardar cambios</button>
            <a class="btn claro" asp-action="Index">Cancelar</a></div>
    </form>
</section>
